{
  "name": "sistema_igreja",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run check-env && next dev",
    "build": "next build --no-lint",
    "start": "next start",
    "lint": "next lint --fix",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap",
    "predeploy": "npm run lint && tsx scripts/deploy-checklist.ts",
    "deploy": "vercel deploy --prod",
    "verify": "tsx scripts/verify-production.ts",
    "deploy:staging": "vercel deploy",
    "type-check": "tsc --noEmit",
    "check-env": "tsx scripts/check-env.ts",
    "deploy:safe": "npm run predeploy && vercel deploy --prod",
    "vercel:setup": "vercel login && vercel link && vercel env pull",
    "deploy:init": "npm run vercel:setup && npm run deploy:safe",
    "verify:setup": "tsx scripts/verify-setup.ts",
    "deploy:prod": "npm run check:deploy && vercel --prod",
    "verify:env": "tsx scripts/verify-vercel-env.ts",
    "check:deploy": "tsx scripts/pre-deploy-check.ts",
    "deploy:final": "tsx scripts/deploy-with-env.ts",
    "fix-types": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.9.0",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/node": "^3.0.0",
    "date-fns": "^4.1.0",
    "next": "^14.0.0",
    "pg": "^8.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.2.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0"
  }
}
